---
import { render } from 'astro:content';
import { KIND_LABEL, period, asset, type Kind } from '../lib/util';
import Video from './Video.astro';
interface Ref { uid: string; title: string; kind: Kind; when: string; result?: string }
interface Props { item: any; related?: Ref; backrefs?: Ref[] }
const { item, related, backrefs = [] } = Astro.props;
const d = item.data;
const kind: Kind = item.kind;
const { Content, headings } = await render(item);

// 목차: 본문의 큰 제목(##)·작은 제목(###) — "3-2. 제목 — 결과" 형식에서 번호·결과를 분리
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3).map((h) => {
  let title = h.text;
  const m = title.match(/^(\d+(?:-\d+)*)\.\s+/);
  const num = m ? m[1] : '';
  if (m) title = title.slice(m[0].length);
  const i = title.indexOf(' — ');
  const badge = i >= 0 ? title.slice(i + 3) : '';
  if (i >= 0) title = title.slice(0, i);
  const code = /^코드:\s*/.test(title);
  if (code) title = title.replace(/^코드:\s*/, '');
  return { ...h, num, title, badge: code ? '' : badge, code };
});
const hasToc = kind === 'project' && toc.length >= 6;
const metrics = (d.metrics ?? []).map((m: any) => {
  const h = m.target ? toc.find((t) => t.num === m.target) ?? toc.find((t) => t.text.startsWith(m.target)) : undefined;
  return { ...m, slug: h?.slug, to: h ? (h.num ? `${h.num} ${h.title}` : h.title) : '' };
});
const facts: [string, string | undefined][] = [
  ['기간', d.hide_dates ? undefined : period(d)],
  ['역할', d.role],
  ['팀', d.team],
  ['기여', d.contribution],
  ['주최', d.organizer],
  ['결과', d.result],
  ['소속', d.organization],
];
---
<article class:list={['detail', { 'has-toc': hasToc }]} id={`detail-${item.uid}`} data-uid={item.uid} data-title={d.title}>
<div class:list={['detail-layout', { on: hasToc }]}>
  {hasToc && (
    <nav class="toc" aria-label="목차">
      <div class="toc-head"><p class="toc-title">목차</p><button type="button" class="toc-fold" aria-label="목차 접기" title="목차 접기">«</button></div>
      <ol>
        {toc.map((t) => (
          <li class:list={[`d${t.depth}`, { code: t.code }]}>
            <button type="button" data-toc={t.slug}>
              {t.num && <span class="toc-num">{t.num}</span>}
              <span class="toc-t">{t.title}{t.badge && <span class="toc-badge">{t.badge}</span>}</span>
            </button>
          </li>
        ))}
      </ol>
    </nav>
  )}
<div class="detail-main">
  <header>
    <span class:list={['kind-pill', `k-${kind}`]}>{KIND_LABEL[kind]}</span>
    <h2>{d.title}</h2>
    {d.summary && <p class="lead">{d.summary}</p>}
    {d.tldr.length > 0 && (
      <ul class="tldr">{d.tldr.map((t: string) => <li>{t}</li>)}</ul>
    )}
  </header>

  {metrics.length > 0 && (
    <div class="metrics">
      {metrics.map((m: any) => (
        <button type="button" data-toc={m.slug} disabled={!m.slug}>
          <strong>{m.value}</strong>
          <span class="m-label">{m.label}</span>
          {m.to && <span class="m-to">{m.to} →</span>}
        </button>
      ))}
    </div>
  )}

  {d.video ? (
    <Video url={d.video} />
  ) : d.thumbnail ? (
    <img class="cover" src={asset(d.thumbnail)} alt="" loading="lazy" />
  ) : null}

  {d.videos.length > 0 && (
    <div class="more-videos">{d.videos.map((u: string) => <Video url={u} />)}</div>
  )}

  <dl class="facts">
    {facts.filter(([, v]) => v).map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
  </dl>

  {d.highlights.length > 0 && (metrics.length > 0 ? (
    <details class="highlights fold">
      <summary>핵심 성과 전체 보기 <span>{d.highlights.length}</span></summary>
      <ul>{d.highlights.map((h: string) => <li>{h}</li>)}</ul>
    </details>
  ) : (
    <section class="highlights">
      <h4>핵심 성과</h4>
      <ul>{d.highlights.map((h: string) => <li>{h}</li>)}</ul>
    </section>
  ))}

  <div class="prose"><Content /></div>

  {d.gallery.length > 0 && (
    <div class="gallery">{d.gallery.map((g: string) => (
      <a href={asset(g)} target="_blank" rel="noopener"><img src={asset(g)} alt="" loading="lazy" /></a>
    ))}</div>
  )}

  {d.certificate && (
    <figure class="cert">
      <a href={asset(d.certificate)} target="_blank" rel="noopener"><img src={asset(d.certificate)} alt="수상 증빙" loading="lazy" /></a>
      <figcaption>증빙 자료</figcaption>
    </figure>
  )}

  {related && (
    <p class="related">관련 프로젝트: <a href={`#item/${related.uid}`} data-open={related.uid}>{related.title} →</a></p>
  )}

  {backrefs.length > 0 && (
    <section class="backrefs">
      <h4>이 프로젝트로 받은 수상 · 함께한 활동 <span>{backrefs.length}</span></h4>
      <ul>
        {backrefs.map((r) => (
          <li>
            <a href={`#item/${r.uid}`} data-open={r.uid}>
              <span class:list={['dot', `k-${r.kind}`]}></span>
              {r.when && <span class="when">{r.when}</span>}
              <span class="t">{r.title}</span>
              {r.result && <span class="r">{r.result}</span>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {(d.tags.length > 0 || d.links.length > 0) && (
    <footer>
      {d.tags.length > 0 && <ul class="tags">{d.tags.map((t: string) => <li>{t}</li>)}</ul>}
      {d.links.length > 0 && (
        <div class="links">{d.links.map((l: any) => <a class="btn" href={l.url} target="_blank" rel="noopener">{l.label} ↗</a>)}</div>
      )}
    </footer>
  )}
</div>
</div>
</article>
