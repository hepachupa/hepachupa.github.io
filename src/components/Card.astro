---
import { KIND_LABEL, period, fmtMonth, asset, type Kind } from '../lib/util';
interface Props { item: any; large?: boolean }
const { item, large = false } = Astro.props;
const d = item.data;
const kind: Kind = item.kind;
const compact = kind !== 'project' && !d.thumbnail && !large;
const meta = kind === 'award' ? [d.organizer, d.result].filter(Boolean).join(' · ')
  : kind === 'activity' ? [d.organization, d.role].filter(Boolean).join(' · ')
  : [d.role, d.team].filter(Boolean).join(' · ');
---
<button
  type="button"
  class:list={['card', `k-${kind}`, { large, compact }]}
  data-open={item.uid}
  data-kind={kind}
  data-tags={d.tags.join('|')}
  data-year={item.year}
>
  {!compact && <div class="thumb">
    {d.thumbnail
      ? <img src={asset(d.thumbnail)} alt="" loading="lazy" decoding="async" />
      : <span class="ph" aria-hidden="true">{d.title.replace(/^\(.*?\)\s*/, '').slice(0, 1)}</span>}
    <span class="kind">{KIND_LABEL[kind]}</span>
    {d.video && <span class="has-video" title="영상 있음">▶</span>}
  </div>}
  <div class="body">
    {compact && <span class="kind inline">{KIND_LABEL[kind]}</span>}
    {!d.hide_dates && <div class="period">{d.ongoing ? <>{fmtMonth(d.start)} – <span class="live">진행 중</span></> : period(d)}</div>}
    <h3>{d.title}</h3>
    {meta && <p class="meta">{meta}</p>}
    {d.summary && <p class="summary">{d.summary}</p>}
    {d.tags.length > 0 && (
      <ul class="tags">{d.tags.slice(0, large ? 6 : 4).map((t: string) => <li>{t}</li>)}</ul>
    )}
  </div>
</button>
